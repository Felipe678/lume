    {
      "parameters": {
        "jsCode": "// Saúde · SOMENTE REGISTRO. Este ramo nunca calcula, sugere ou recomenda dose.\n// LGPD art. 11: guarda apenas identificadores e o tipo do fato, jamais valores clínicos no log do n8n.\nreturn $input.all().map((item) => {\n  const b = (item.json && item.json.body) || item.json || {};\n  const id = String(b.aplicacaoId || '').replace(/[^A-Za-z0-9-]/g, '').slice(0, 64);\n  return { json: {\n    tarefa: 'produto:saude',\n    etapa: 'registro',\n    agente: 'lume-produto',\n    status: 'concluida',\n    resumo: 'Aplicação registrada' + (id ? ' (' + id + ')' : '') + '. O app apenas registra; não há recomendação de dose.',\n    sessao: '',\n    ts: new Date().toISOString(),\n    operacao: 'registrar_estado',\n    valido: true,\n  } };\n});\n"
      },
      "id": "c64a94b4-e244-4d7e-a84f-dc1dd8d194da",
      "name": "Registrar aplicação (somente registro)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        400
      ]
    },
