# Variáveis do n8n local do Lume. Copie para .env (ou deixe o "lume-n8n.mjs up" gerar um com segredos aleatórios).
# NUNCA versione o .env.

# Porta no host (só 127.0.0.1).
LUME_N8N_PORT=5678

# Banco Postgres do n8n (interno ao compose, sem porta publicada).
LUME_N8N_DB_NAME=n8n
LUME_N8N_DB_USER=n8n
LUME_N8N_DB_PASSWORD=

# Chave que criptografa as credenciais salvas no n8n. Perdeu a chave = perdeu as credenciais.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUME_N8N_ENCRYPTION_KEY=

# Token compartilhado entre os hooks do Claude Code e o webhook /webhook/lume-dev-evento (header).
LUME_N8N_TOKEN=
