# MongoDB Atlas (free tier): crie um cluster em https://cloud.mongodb.com e cole a connection string
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/lume?retryWrites=true&w=majority

# Segredo do JWT — gere um valor longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

PORT=4000
CORS_ORIGIN=http://localhost:5173
